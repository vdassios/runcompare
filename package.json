{
  "name": "runcompare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check \"**/*.{ts,tsx,js,css,html,json}\" \"!.claude/**\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,css,html,json}\" \"!.claude/**\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "sanitize": "tsx scripts/sanitize-samples.ts",
    "lint:commits": "commitlint --from origin/main --to HEAD"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@garmin/fitsdk": "21.218.0",
    "d3-array": "3.2.4",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "leaflet": "1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/d3-array": "3.2.2",
    "@types/d3-random": "3.0.4",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.2",
    "d3-random": "3.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
